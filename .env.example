# .env.example — copy to `.env` and fill in. `.env` is git-ignored.
#
# This suite ports the Mule app's layered property system: config/config-<env>.yaml (non-secret)
# + config/config-secure-<env>.yaml (AES-CBC encrypted secrets). Because the secrets are already
# encrypted in the committed YAML, the ONLY thing you must supply here is the decryption key.
#
# Everything else below is OPTIONAL and only needed if you want to (a) select a non-default
# environment, (b) override a secret without re-encrypting the YAML, or (c) point the job store /
# server somewhere specific. Any variable set here overrides the value resolved from the YAML.

# ── REQUIRED to use encrypted secrets ─────────────────────────────────────────────────────────
# The AES key used with secure-properties-tool.jar (encrypt AES CBC <key>). 16/24/32 chars.
# NEVER commit the real key. Set it only in your local .env (which is git-ignored).
#
# SET ONCE — never typed per command. lib_shared/env.js auto-loads this .env from the SUITE ROOT
# on every skill/CLI/server run (it walks up from its own file location, so the current directory
# and where Vibes invokes from don't matter). That's why Vibes skills must be SYMLINKED (not
# copied): a symlinked skill resolves ../../lib_shared back into this suite, so this one .env is
# always the file that loads — the user sets the key once and is never prompted again.
MULE_CONFIG_KEY=

# Per-environment keys (OPTIONAL). If an env's config-secure-<env>.yaml was encrypted with a
# DIFFERENT key, set MULE_CONFIG_KEY_<ENV> and it auto-wins for that env (the active MULE_UPGRADE_ENV
# selects it), falling back to MULE_CONFIG_KEY when unset. Here all three envs share one key, so
# MULE_CONFIG_KEY alone is enough — these are only for when the per-env keys diverge.
# MULE_CONFIG_KEY_DEV=
# MULE_CONFIG_KEY_LOCAL=
# MULE_CONFIG_KEY_PROD=

# ── Environment selector (MANDATORY — no default) ─────────────────────────────────────────────
# Chooses config-<env>.yaml + config-secure-<env>.yaml AND (via MULE_CONFIG_KEY_<ENV>) the key.
# One of: dev | local | prod.
#
# This is a REQUIRED input on every run — there is NO silent "dev" default, mirroring the Mule
# app's mandatory -Denv / mule.env selector. Supply it EITHER by setting MULE_UPGRADE_ENV here
# (recommended: set once in .env) OR by passing --env <dev|local|prod> at each command. If neither
# is present, every entrypoint (skills, CLIs, and the server at boot) fails fast with a clear
# "environment is required" error rather than assuming an environment.
MULE_UPGRADE_ENV=dev

# ── Job store location (default: ~/.mule-upgrade) ─────────────────────────────────────────────
MULE_UPGRADE_HOME=

# ── Server (Agentforce / remote MCP) ──────────────────────────────────────────────────────────
# Bearer token clients must present as `Authorization: Bearer <token>` to call MCP/REST.
MCP_BEARER_TOKEN=
# Port the HTTP/MCP server listens on (default 8080).
MCP_SERVER_PORT=8080

# ── OPTIONAL plaintext secret overrides (skip if using the encrypted YAML) ────────────────────
# Uncomment any of these to override the decrypted YAML value with a plaintext env var. Useful
# for CI / container / Agentforce hosting where you inject secrets instead of shipping the key.
# GITHUB_TOKEN=
# GITHUB_WEBHOOK_SECRET=
# ANYPOINT_CLIENT_ID=
# ANYPOINT_CLIENT_SECRET=
# SLACK_WEBHOOK_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
