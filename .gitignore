# ─────────────────────────────────────────────────────────────────────────────
# Dependencies
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnpm-store/
jspm_packages/

# ─────────────────────────────────────────────────────────────────────────────
# Logs & debug output
# ─────────────────────────────────────────────────────────────────────────────
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# Secrets & local environment (NEVER commit real secrets / the AES key)
#   - config-secure-<env>.yaml is committed on purpose (values are AES-encrypted)
#   - .env.example is committed on purpose (empty template)
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ─────────────────────────────────────────────────────────────────────────────
# Local job store / runtime state (MULE_UPGRADE_HOME) & caches
#   Default home is ~/.mule-upgrade (outside the repo); these cover an in-repo
#   MULE_UPGRADE_HOME=./.local-jobstore and any cache written into the tree.
# ─────────────────────────────────────────────────────────────────────────────
.mule-upgrade/
.local-jobstore/
matrix-cache.json
scan-watch.json

# ─────────────────────────────────────────────────────────────────────────────
# Generated / scratch outputs (assess plans, staged blobs, exports)
# ─────────────────────────────────────────────────────────────────────────────
plan.json
*.plan.json
out/
tmp/
temp/
.cache/

# ─────────────────────────────────────────────────────────────────────────────
# Test & coverage artifacts
# ─────────────────────────────────────────────────────────────────────────────
coverage/
*.lcov
.nyc_output/
junit.xml
test-results/

# ─────────────────────────────────────────────────────────────────────────────
# Vibes / Anypoint Code Builder workspace scaffolding (skill symlinks live here)
# ─────────────────────────────────────────────────────────────────────────────
.a4drules/

# ─────────────────────────────────────────────────────────────────────────────
# Agent research scratch (one-off probes, findings notes, raw evidence dumps)
#   Kept on disk as a research trail, but not shipped. The three exceptions are
#   the documented regeneration pipeline for the SHIPPED
#   mule-upgrade-assess/references/connector-notes-map.yaml:
#     build_notes_map.mjs -> connector-notes-map.raw.json -> assemble_notes_map.mjs
#   Excluding `.agents/*` rather than `.agents/` is deliberate: git cannot
#   re-include a file whose parent DIRECTORY is excluded, so the negations below
#   would silently do nothing.
# ─────────────────────────────────────────────────────────────────────────────
.agents/*
!.agents/artifacts/
.agents/artifacts/*
!.agents/artifacts/build_notes_map.mjs
!.agents/artifacts/assemble_notes_map.mjs
!.agents/artifacts/connector-notes-map.raw.json

# ─────────────────────────────────────────────────────────────────────────────
# Third-party reference documents
#   The MuleSoft upgrade guides are ~27 MB of redistributable-restricted vendor
#   PDFs. They are the SOURCE the compatibility matrix and the processGuide
#   checklist were derived from, but nothing reads them at runtime — keep them
#   locally, cite them by title in the matrix instead of committing them.
# ─────────────────────────────────────────────────────────────────────────────
docs/*.pdf
*.docx
*.pptx

# ─────────────────────────────────────────────────────────────────────────────
# Editor / IDE
#   NOTE: .cursor/ is deliberately NOT ignored — .cursor/hooks.json and
#   .cursor/hooks/refresh-jobs.mjs are a shipped feature (they refresh job
#   status on session start), so they must travel with the repo.
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ─────────────────────────────────────────────────────────────────────────────
# OS cruft
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
# Backups / temp files
# ─────────────────────────────────────────────────────────────────────────────
*.bak
*.orig
*.tmp
*.temp
*~
